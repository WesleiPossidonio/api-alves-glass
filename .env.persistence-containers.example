# Template local exclusivo para docker-compose.persistence.yml.
# Copie para .env.persistence-containers local e nunca versione o arquivo copiado.
# Não iniciar serviços, criar databases, executar migrations ou bootstrap somente com este template.

# Instância isolada de rebuild. A porta 5433 é apenas proposta e deve ser verificada antes do uso.
REBUILD_POSTGRES_DB=alvesglass_rebuild
REBUILD_POSTGRES_USER=
REBUILD_POSTGRES_PASSWORD=
REBUILD_POSTGRES_HOST_PORT=5433

# Instância isolada de integração. A porta 5434 é apenas proposta e deve ser verificada antes do uso.
TEST_POSTGRES_DB=alvesglass_test
TEST_POSTGRES_USER=
TEST_POSTGRES_PASSWORD=
TEST_POSTGRES_HOST_PORT=5434