{
  "name": "back-end",
  "version": "1.0.0",
  "main": "src/server.js",
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "sequelize-cli": "^6.6.3"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/unit/**/*.test.js\" \"unit/configuration/*.test.js\" \"unit/persistence/*.test.js\" \"unit/stock/*.test.js\"",
    "test:watch": "node --watch --test --test-concurrency=1 \"tests/unit/**/*.test.js\" \"unit/configuration/*.test.js\" \"unit/persistence/*.test.js\" \"unit/stock/*.test.js\"",
    "test:integration": "node --test tests/integration/*.postgres.test.js tests/integration/stock/*.postgres.test.js",
    "inventory:outbox-worker": "node src/app/services/InventoryOutboxPublisher.js",
    "inventory:projection-consumer": "node src/app/services/InventoryProjectionConsumer.js",
    "dev": "nodemon",
    "debug": "nodemon --inspect",
    "start": "node -r sucrase/register src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "test:integration:cqrs": "node --test tests/integration/stock/cqrs-real.integration.test.js"
  },
  "type": "module",
