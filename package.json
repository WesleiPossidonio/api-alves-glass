    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "google-auth-library": "^10.7.0",
    "googleapis": "^165.0.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "mjml": "^4.16.1",
    "mongodb": "^7.8.0",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.5",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "stream": "^0.0.3",
    "sucrase": "^3.35.0",
