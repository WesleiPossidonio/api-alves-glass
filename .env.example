# Exemplo de contrato de configuração da fundação de persistência.
# Copie para .env local não versionado e preencha somente com valores autorizados.
# Não inclua neste arquivo segredos, credenciais ou identidades reais.
# Bootstrap e rebuild reais permanecem bloqueados até a aprovação operacional de T006.

# Perfil reconhecido: development-rebuild, test ou inventory-readonly.
PERSISTENCE_PROFILE=
NODE_ENV=

# Identidade da instância PostgreSQL declarada para o perfil selecionado.
PERSISTENCE_INSTANCE_HOST=
PERSISTENCE_INSTANCE_PORT=
PERSISTENCE_INSTANCE_PROFILE=

# Identidade do banco de destino. Os campos devem corresponder exatamente
# a uma entrada autorizada da configuração de identidade não versionada.
BASELINE_DB_HOST=
BASELINE_DB_PORT=
BASELINE_DB_DATABASE=
BASELINE_DB_USERNAME=
BASELINE_DB_PASSWORD=

# Referência não sigilosa à identidade protegida do banco original.
# A identidade completa real permanece somente na configuração não versionada.
PERSISTENCE_PROTECTED_ORIGINAL_REFERENCE=

# Caminho absoluto e canônico do conjunto exclusivo de migrations do baseline.
# O valor real será validado em T013; não usar caminho legado nem .sequelizerc.
BASELINE_MIGRATIONS_PATH=

# Caminho local não versionado para allowlist e denylist operacionais.
# O arquivo deve conter registros reais aprovados fora do repositório.
BASELINE_IDENTITY_CONFIG_PATH=