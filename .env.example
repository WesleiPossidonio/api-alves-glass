# Feature 003 local integrations. Supply credentials through ignored local env files.
# Never put real credentials in this tracked example.
SECRET_KAY=
EXPIRESIN_KAY=
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_CA_CERT_PATH=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC_BUCKET=
MINIO_PRIVATE_BUCKET=
# MINIO_BUCKET remains reserved for legacy document uploads (for example PDFs).

MONGODB_URI=
MONGODB_DATABASE=feature003_ephemeral
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

RABBITMQ_URL=
RABBITMQ_HEARTBEAT_SECONDS=30
RABBITMQ_CONNECTION_TIMEOUT_MS=5000
INVENTORY_SNAPSHOT_EVENT_INTERVAL=500

# For deploy/feature003-test/compose.yml; generate unique disposable local credentials.
FEATURE003_MONGO_USER=
FEATURE003_MONGO_PASSWORD=
FEATURE003_MONGO_DATABASE=feature003_ephemeral
FEATURE003_RABBITMQ_USER=
FEATURE003_RABBITMQ_PASSWORD=
